# Oracle Flashback Automation — Environment Variables Template
#
# Copy this file to .env if you wish to use a local env loader (optional).
# The primary configuration method is config.json — see config.example.json.
#
# NOTE: config.json is the required configuration file. This .env.example
# is provided as a reference only for teams using environment variable injection
# (e.g. CI/CD pipelines, Docker deployments, or systemd unit files).
#
# DO NOT commit a populated .env file to version control.

# ── Operator ──────────────────────────────────────────────────────────────────
# Overrides the operator_id in config.json (used in audit logs)
# FLASHBACK_OPERATOR_ID=your.name

# ── Oracle DB (network auth mode only) ────────────────────────────────────────
# Only needed when oracle.auth_mode = "network" in config.json
# FLASHBACK_DB_HOST=db-server.example.com
# FLASHBACK_DB_PORT=1521
# FLASHBACK_DB_SERVICE=RXEST01
# FLASHBACK_DB_USER=sys
# FLASHBACK_DB_PASS=your_password_here

# ── Shell override ─────────────────────────────────────────────────────────────
# Force a specific bash path if auto-detection fails (Windows only)
# FLASHBACK_BASH_PATH=C:\Program Files\Git\bin\bash.exe

# ── Email (SMTP) ───────────────────────────────────────────────────────────────
# FLASHBACK_SMTP_HOST=smtp.example.com
# FLASHBACK_SMTP_PORT=587
# FLASHBACK_SMTP_USER=alerts@example.com
# FLASHBACK_SMTP_PASS=your_smtp_password

# ── Demo mode override ─────────────────────────────────────────────────────────
# Set to "false" to force production mode regardless of config.json
# FLASHBACK_DEMO=false
