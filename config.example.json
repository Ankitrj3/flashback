{
  "_comment": "Oracle Flashback Automation v2.1 — config.json template. Copy to config.json and fill in your values.",

  "shell_mode": "auto",
  "bash_path": "",
  "operator_id": "oracle",
  "instance_id": "RXEST01",

  "oracle": {
    "_comment": "auth_mode=os uses 'sqlplus / as sysdba' (run on DB server). auth_mode=network uses host:port connect string.",
    "env_file":   "/db8000/app/oracle/r122rxest01/rxecst01.sh",
    "auth_mode":  "os",
    "db_host":    "",
    "db_port":    "1521",
    "db_service": "",
    "pdb_name":   "RXEST01",
    "db_user":    "sys",
    "db_pass":    ""
  },

  "app": {
    "_comment": "Application node hostnames that run EBS services. Backed up and shut down during Restore workflow.",
    "nodes":    ["node2", "node3", "node4", "node5", "node6", "node7"],
    "ssh_user": "oracle",
    "ssh_key":  "",
    "base_dir": "/db8000/app/oracle/r122rxest01"
  },

  "backup": {
    "_comment": "Filesystems are RELATIVE names under app.base_dir. Backed up with nohup tar in parallel.",
    "dir":         "/iriscommon/backups/tars",
    "filesystems": ["fs_ne", "fs1", "fs2"]
  },

  "demo": {
    "enabled": true,
    "restore_points_file": "demo/restore_points.json",
    "sessions_file": "demo/active_sessions.json",
    "soa_action": "WARN"
  },

  "preflight": {
    "run_connectivity_before_execute": true,
    "abort_on_connectivity_failure": true
  },

  "scripts": {
    "test_connectivity":     "scripts/test_connectivity.sh",
    "shutdown_app_services": "scripts/shutdown_app_services.sh",
    "list_restore_points":   "scripts/list_restore_points.sh",
    "create_backup":         "scripts/create_backup.sh",
    "restore_backup":        "scripts/restore_backup.sh",
    "create_flashback":      "scripts/create_flashback_restore_point.sh",
    "flashback_restore":     "scripts/flashback_to_restore_point.sh"
  },

  "email": {
    "enabled": false,
    "smtp_host": "",
    "smtp_port": 587,
    "smtp_user": "",
    "smtp_password": "",
    "from_addr": "flashback-tool@example.com",
    "to_addrs":  ["dba-team@example.com"],
    "subject_prefix": "[FLASHBACK] ",
    "use_tls": true
  },

  "logging": {
    "log_dir": "logs",
    "max_log_files": 30
  },

  "timeout": {
    "script_timeout_secs": 7200,
    "connectivity_timeout_secs": 30
  }
}
